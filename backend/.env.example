# Copy to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Omit to use local SQLite instead of Postgres.
DATABASE_URL=

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Platform Stripe account - checkout sessions and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect - lets a workspace owner link their own Stripe
# account so client payments go straight to them.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
